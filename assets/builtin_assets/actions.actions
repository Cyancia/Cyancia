[pan_tool]
shortcut = [["KeyH"]]
enabled_in = ["main_view"]

[rotate_tool]
shortcut = [["KeyR"]]
enabled_in = ["main_view"]

[zoom_tool]
shortcut = [["KeyZ"]]
enabled_in = ["main_view"]

[brush_tool]
shortcut = [["KeyB"]]
enabled_in = ["main_view"]

[open_file_action]
shortcut = [["ControlLeft", "KeyO"]]
enabled_in = ["main_view"]

[open_brush_editor_action]
shortcut = [["F5"]]
enabled_in = ["main_view"]

[create_new_layer_action]
shortcut = [["ControlLeft", "ShiftLeft", "KeyN"]]
enabled_in = ["main_view"]

[group_active_layer_action]
shortcut = [["ControlLeft", "KeyG"]]
enabled_in = ["main_view"]

[move_layer_up_action]
shortcut = [["ControlLeft", "ShiftLeft", "ArrowUp"]]
enabled_in = ["main_view"]

[move_layer_down_action]
shortcut = [["ControlLeft", "ShiftLeft", "ArrowDown"]]
enabled_in = ["main_view"]
