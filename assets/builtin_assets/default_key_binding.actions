{
  "name": "Default Key Bindings",
  "actions": [
    {
      "shortcut": "ctrl-o",
      "action_name": "OpenFileAction",
      "context": "main_view"
    },
    {
      "shortcut": "f5",
      "action_name": "OpenBrushEditorAction"
    },
    {
      "shortcut": "ctrl-shift-f",
      "action_name": "ToggleFilterPanelAction"
    },
    {
      "shortcut": "ctrl-shift-n",
      "action_name": "CreateNewLayerAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-g",
      "action_name": "GroupSelectedLayersAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-shift-up",
      "action_name": "MoveLayerUpAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-shift-down",
      "action_name": "MoveLayerDownAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-delete",
      "action_name": "DeleteSelectedLayersAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-z",
      "action_name": "UndoAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-shift-z",
      "action_name": "RedoAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-d",
      "action_name": "DeleteSelectionAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-down",
      "action_name": "SelectNextLayerAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-up",
      "action_name": "SelectPreviousLayerAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-v",
      "action_name": "PasteIntoNewLayerAction",
      "context": "main_view"
    },
    {
      "shortcut": "ctrl-s",
      "action_name": "SaveFileAction",
      "context": "main_view"
    }
  ]
}
